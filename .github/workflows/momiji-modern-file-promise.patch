+bool PasteboardHasModernFilePromise(NSPasteboard* aPasteboard) {
+  return aPasteboard &&
+         [[aPasteboard types]
+             containsObject:(NSString*)kPasteboardTypeFileURLPromise];
+}
+
+uint32_t ModernFilePromiseCount(NSPasteboard* aPasteboard) {
+  if (!PasteboardHasModernFilePromise(aPasteboard)) {
+    return 0;
+  }
+
+  NSString* pasteboardName = [aPasteboard name];
+  if (!pasteboardName) {
+    return 0;
+  }
+
+  PasteboardRef carbonPasteboard = nullptr;
+  OSStatus status =
+      PasteboardCreate((CFStringRef)pasteboardName, &carbonPasteboard);
+  if (!carbonPasteboard) {
+    return 0;
+  }
+  auto releasePasteboard =
+      MakeScopeExit([carbonPasteboard]() { CFRelease(carbonPasteboard); });
+  if (status != noErr) {
+    return 0;
+  }
+
+  PasteboardSynchronize(carbonPasteboard);
+  ItemCount itemCount = 0;
+  status = PasteboardGetItemCount(carbonPasteboard, &itemCount);
+  if (status != noErr || itemCount > kMaximumPromisedFileCount) {
+    return 0;
+  }
+
+  for (ItemCount index = 1; index <= itemCount; ++index) {
+    PasteboardItemID itemIdentifier = nullptr;
+    PasteboardFlavorFlags flags = 0;
+    if (PasteboardGetItemIdentifier(carbonPasteboard, index, &itemIdentifier) !=
+            noErr ||
+        PasteboardGetItemFlavorFlags(carbonPasteboard, itemIdentifier,
+                                     kPasteboardTypeFileURLPromise,
+                                     &flags) != noErr) {
+      return 0;
+    }
+  }
+
+  return static_cast<uint32_t>(itemCount);
+}
+
+uint32_t FilePromiseCount(NSPasteboard* aPasteboard) {
+  return ModernFilePromiseCount(aPasteboard);
+}
+
+bool SameDirectoryIdentity(const struct stat& aLeft,
+                           const struct stat& aRight) {
+  return S_ISDIR(aLeft.st_mode) && S_ISDIR(aRight.st_mode) &&
+         aLeft.st_uid == geteuid() && aRight.st_uid == geteuid() &&
+         (aLeft.st_mode & 077) == 0 && (aRight.st_mode & 077) == 0 &&
+         aLeft.st_dev == aRight.st_dev && aLeft.st_ino == aRight.st_ino;
+}
+
+bool SameRegularFileState(const struct stat& aLeft, const struct stat& aRight) {
+  return S_ISREG(aLeft.st_mode) && S_ISREG(aRight.st_mode) &&
+         aLeft.st_uid == geteuid() && aRight.st_uid == geteuid() &&
+         aLeft.st_nlink == 1 && aRight.st_nlink == 1 &&
+         aLeft.st_dev == aRight.st_dev && aLeft.st_ino == aRight.st_ino &&
+         aLeft.st_size == aRight.st_size && aLeft.st_mode == aRight.st_mode &&
+         aLeft.st_mtimespec.tv_sec == aRight.st_mtimespec.tv_sec &&
+         aLeft.st_mtimespec.tv_nsec == aRight.st_mtimespec.tv_nsec &&
+         aLeft.st_ctimespec.tv_sec == aRight.st_ctimespec.tv_sec &&
+         aLeft.st_ctimespec.tv_nsec == aRight.st_ctimespec.tv_nsec;
+}
+
+bool DirectoryDescriptorMatchesPath(int aDescriptor, nsIFile* aDirectory) {
+  nsAutoCString nativePath;
+  struct stat descriptorStatus;
+  struct stat pathStatus;
+  return aDescriptor >= 0 &&
+         NS_SUCCEEDED(aDirectory->GetNativePath(nativePath)) &&
+         fstat(aDescriptor, &descriptorStatus) == 0 &&
+         lstat(nativePath.get(), &pathStatus) == 0 &&
+         SameDirectoryIdentity(descriptorStatus, pathStatus);
+}
+
+bool FileDescriptorMatchesPath(int aDescriptor, nsIFile* aFile,
+                               const struct stat& aExpectedStatus) {
+  nsAutoCString nativePath;
+  struct stat descriptorStatus;
+  struct stat pathStatus;
+  return aDescriptor >= 0 && NS_SUCCEEDED(aFile->GetNativePath(nativePath)) &&
+         fstat(aDescriptor, &descriptorStatus) == 0 &&
+         lstat(nativePath.get(), &pathStatus) == 0 &&
+         SameRegularFileState(descriptorStatus, aExpectedStatus) &&
+         SameRegularFileState(pathStatus, aExpectedStatus);
+}
+
+nsresult OpenPrivateDirectory(nsIFile* aDirectory, int* aDescriptor) {
+  MOZ_ASSERT(aDirectory);
+  MOZ_ASSERT(aDescriptor);
+
+  *aDescriptor = -1;
+  nsAutoCString nativePath;
+  if (NS_FAILED(aDirectory->GetNativePath(nativePath))) {
+    return NS_ERROR_FAILURE;
+  }
+
+  int descriptor =
+      open(nativePath.get(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (descriptor < 0 ||
+      !DirectoryDescriptorMatchesPath(descriptor, aDirectory)) {
+    if (descriptor >= 0) {
+      close(descriptor);
+    }
+    return NS_ERROR_FAILURE;
+  }
+
+  *aDescriptor = descriptor;
+  return NS_OK;
+}
+
+nsresult CreatePrivateDirectory(nsIFile* aParent, const char* aName,
+                                bool aCreateUnique,
+                                nsCOMPtr<nsIFile>& aDirectory) {
+  nsCOMPtr<nsIFile> directory;
+  nsresult rv = aParent->Clone(getter_AddRefs(directory));
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+
+  rv = directory->AppendNative(nsDependentCString(aName));
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+
+  rv = aCreateUnique ? directory->CreateUnique(nsIFile::DIRECTORY_TYPE, 0700)
+                     : directory->Create(nsIFile::DIRECTORY_TYPE, 0700);
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+
+  int descriptor = -1;
+  rv = OpenPrivateDirectory(directory, &descriptor);
+  if (NS_FAILED(rv)) {
+    Unused << directory->Remove(false);
+    return rv;
+  }
+  auto closeDirectory =
+      MakeScopeExit([descriptor]() { Unused << close(descriptor); });
+
+  if (fchmod(descriptor, 0700) != 0 ||
+      !DirectoryDescriptorMatchesPath(descriptor, directory) ||
+      !KeepPromisedFileDirectoryUntilShutdown(directory)) {
+    // This path has not been disclosed and no source data has been written.
+    Unused << directory->Remove(false);
+    return NS_ERROR_FAILURE;
+  }
+
+  aDirectory = directory;
+  return NS_OK;
+}
+
+nsresult ValidatePromiseURLAndAppendName(NSURL* aFileURL,
+                                         NSString* aStandardDestinationPath,
+                                         nsTArray<nsString>& aPromisedNames) {
+  if (!aFileURL || ![aFileURL isFileURL] || [aFileURL query] ||
+      [aFileURL fragment]) {
+    return NS_ERROR_FAILURE;
+  }
+
+  NSString* host = [aFileURL host];
+  if (host && [host length] &&
+      [host caseInsensitiveCompare:@"localhost"] != NSOrderedSame) {
+    return NS_ERROR_FAILURE;
+  }
+
+  NSString* path = [aFileURL path];
+  NSString* standardPath = [path stringByStandardizingPath];
+  NSString* name = [standardPath lastPathComponent];
+  if (![standardPath isAbsolutePath] || ![name length] ||
+      [name isEqualToString:@"."] || [name isEqualToString:@".."] ||
+      ![[name lastPathComponent] isEqualToString:name] ||
+      ![[standardPath stringByDeletingLastPathComponent]
+          isEqualToString:aStandardDestinationPath]) {
+    return NS_ERROR_FAILURE;
+  }
+
+  nsAutoString promisedName;
+  nsCocoaUtils::GetStringForNSString(name, promisedName);
+  if (promisedName.IsEmpty() || promisedName.FindChar(u'\0') != kNotFound) {
+    return NS_ERROR_FAILURE;
+  }
+
+  for (const auto& otherName : aPromisedNames) {
+    if (promisedName.Equals(otherName)) {
+      return NS_ERROR_FAILURE;
+    }
+  }
+
+  aPromisedNames.AppendElement(promisedName);
+  return NS_OK;
+}
+
+nsresult RelocatePromiseDirectory(nsIFile* aInboxDirectory,
+                                  int aInboxDescriptor, nsIFile* aPrivateRoot,
+                                  int aPrivateRootDescriptor,
+                                  nsCOMPtr<nsIFile>& aSourceDirectory) {
+  if (!DirectoryDescriptorMatchesPath(aInboxDescriptor, aInboxDirectory) ||
+      !DirectoryDescriptorMatchesPath(aPrivateRootDescriptor, aPrivateRoot)) {
+    return NS_ERROR_FAILURE;
+  }
+
+  nsCOMPtr<nsIFile> sourceDirectory;
+  nsresult rv = aPrivateRoot->Clone(getter_AddRefs(sourceDirectory));
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+  rv = sourceDirectory->AppendNative(
+      nsDependentCString(kPromiseSourceDirectoryName));
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+
+  nsAutoCString inboxPath;
+  nsAutoCString sourcePath;
+  if (NS_FAILED(aInboxDirectory->GetNativePath(inboxPath)) ||
+      NS_FAILED(sourceDirectory->GetNativePath(sourcePath))) {
+    return NS_ERROR_FAILURE;
+  }
+
+  struct stat unexpectedDestination;
+  if (lstat(sourcePath.get(), &unexpectedDestination) == 0 || errno != ENOENT) {
+    return NS_ERROR_FAILURE;
+  }
+
+  if (!TrackPromisedFileDirectoryRelocationDestination(
+          aInboxDirectory, sourceDirectory, aInboxDescriptor)) {
+    return NS_ERROR_FAILURE;
+  }
+
+  if (rename(inboxPath.get(), sourcePath.get()) != 0) {
+    Unused << ForgetTrackedPromisedFileDirectoryPath(sourceDirectory);
+    return NS_ERROR_FAILURE;
+  }
+
+  // Returning this best-known path on later failure lets the caller attempt
+  // descriptor-verified cleanup; the pre-registered identity also remains a
+  // safe shutdown fallback if verification cannot be repeated.
+  aSourceDirectory = sourceDirectory;
+
+  struct stat descriptorStatus;
+  struct stat sourceStatus;
+  if (fstat(aInboxDescriptor, &descriptorStatus) != 0 ||
+      lstat(sourcePath.get(), &sourceStatus) != 0 ||
+      !SameDirectoryIdentity(descriptorStatus, sourceStatus)) {
+    return NS_ERROR_FAILURE;
+  }
+
+  if (!ForgetTrackedPromisedFileDirectoryPath(aInboxDirectory)) {
+    return NS_ERROR_FAILURE;
+  }
+
+  if (!DirectoryDescriptorMatchesPath(aPrivateRootDescriptor, aPrivateRoot) ||
+      fchmod(aInboxDescriptor, 0500) != 0) {
+    return NS_ERROR_FAILURE;
+  }
+
+  return NS_OK;
+}
+
+ssize_t ReadAt(int aDescriptor, void* aBuffer, size_t aLength, off_t aOffset) {
+  ssize_t result;
+  do {
+    result = pread(aDescriptor, aBuffer, aLength, aOffset);
+  } while (result < 0 && errno == EINTR);
+  return result;
+}
+
+bool ReadExactlyAt(int aDescriptor, void* aBuffer, size_t aLength,
+                   off_t aOffset) {
+  size_t completed = 0;
+  while (completed < aLength) {
+    ssize_t result =
+        ReadAt(aDescriptor, static_cast<char*>(aBuffer) + completed,
+               aLength - completed, aOffset + completed);
+    if (result <= 0) {
+      return false;
+    }
+    completed += static_cast<size_t>(result);
+  }
+  return true;
+}
+
+bool WriteExactlyAt(int aDescriptor, const void* aBuffer, size_t aLength,
+                    off_t aOffset) {
+  size_t completed = 0;
+  while (completed < aLength) {
+    ssize_t result;
+    do {
+      result =
+          pwrite(aDescriptor, static_cast<const char*>(aBuffer) + completed,
+                 aLength - completed, aOffset + completed);
+    } while (result < 0 && errno == EINTR);
+    if (result <= 0) {
+      return false;
+    }
+    completed += static_cast<size_t>(result);
+  }
+  return true;
+}
+
+nsresult SnapshotPromisedFile(
+    nsIFile* aSourceDirectory, int aSourceDirectoryDescriptor,
+    nsIFile* aDeliveryDirectory, int aDeliveryDirectoryDescriptor,
+    const nsAString& aLeafName, uint64_t& aAggregateBytes,
+    PendingPromisedFiles& aPendingFiles,
+    AutoTArray<nsCOMPtr<nsIFile>, 4>& aPromisedFiles) {
+  if (!DirectoryDescriptorMatchesPath(aSourceDirectoryDescriptor,
+                                      aSourceDirectory) ||
+      !DirectoryDescriptorMatchesPath(aDeliveryDirectoryDescriptor,
+                                      aDeliveryDirectory)) {
+    return NS_ERROR_FAILURE;
+  }
+
+  nsCOMPtr<nsIFile> sourceFile;
+  nsresult rv = aSourceDirectory->Clone(getter_AddRefs(sourceFile));
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+  rv = sourceFile->Append(aLeafName);
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+
+  nsAutoCString sourcePath;
+  if (NS_FAILED(sourceFile->GetNativePath(sourcePath))) {
+    return NS_ERROR_FAILURE;
+  }
+  int sourceDescriptor =
+      open(sourcePath.get(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK);
+  if (sourceDescriptor < 0) {
+    return NS_ERROR_FAILURE;
+  }
+  auto closeSource =
+      MakeScopeExit([sourceDescriptor]() { close(sourceDescriptor); });
+
+  struct stat sourceStatus;
+  if (fstat(sourceDescriptor, &sourceStatus) != 0 ||
+      !S_ISREG(sourceStatus.st_mode) || sourceStatus.st_uid != geteuid() ||
+      sourceStatus.st_nlink != 1 || sourceStatus.st_size < 0 ||
+      !FileDescriptorMatchesPath(sourceDescriptor, sourceFile, sourceStatus)) {
+    return NS_ERROR_FAILURE;
+  }
+  aPendingFiles.AddSource(sourceFile, sourceStatus);
+  if (sourceStatus.st_size > kMaximumPromisedFileBytes) {
+    return NS_ERROR_FAILURE;
+  }
+
+  uint64_t sourceBytes = static_cast<uint64_t>(sourceStatus.st_size);
+  if (sourceBytes > kMaximumPromisedFileAggregateBytes - aAggregateBytes) {
+    return NS_ERROR_FAILURE;
+  }
+
+  nsCOMPtr<nsIFile> deliveryFile;
+  rv = aDeliveryDirectory->Clone(getter_AddRefs(deliveryFile));
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+  rv = deliveryFile->Append(aLeafName);
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+
+  nsAutoCString deliveryPath;
+  if (NS_FAILED(deliveryFile->GetNativePath(deliveryPath))) {
+    return NS_ERROR_FAILURE;
+  }
+  int deliveryDescriptor =
+      open(deliveryPath.get(),
+           O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+  if (deliveryDescriptor < 0) {
+    return NS_ERROR_FAILURE;
+  }
+  auto closeDelivery =
+      MakeScopeExit([deliveryDescriptor]() { close(deliveryDescriptor); });
+
+  struct stat deliveryStatus;
+  if (fstat(deliveryDescriptor, &deliveryStatus) != 0 ||
+      !S_ISREG(deliveryStatus.st_mode) || deliveryStatus.st_uid != geteuid() ||
+      deliveryStatus.st_nlink != 1 ||
+      !FileDescriptorMatchesPath(deliveryDescriptor, deliveryFile,
+                                 deliveryStatus)) {
+    return NS_ERROR_FAILURE;
+  }
+  aPendingFiles.AddDelivery(deliveryFile, deliveryStatus);
+  if (fchmod(deliveryDescriptor, 0600) != 0) {
+    return NS_ERROR_FAILURE;
+  }
+
+  auto sourceBuffer = MakeUnique<char[]>(kPromiseCopyBufferBytes);
+  auto deliveryBuffer = MakeUnique<char[]>(kPromiseCopyBufferBytes);
+  off_t offset = 0;
+  while (offset < sourceStatus.st_size) {
+    off_t remaining = sourceStatus.st_size - offset;
+    size_t length = remaining < static_cast<off_t>(kPromiseCopyBufferBytes)
+                        ? static_cast<size_t>(remaining)
+                        : kPromiseCopyBufferBytes;
+    if (!ReadExactlyAt(sourceDescriptor, sourceBuffer.get(), length, offset) ||
+        !WriteExactlyAt(deliveryDescriptor, sourceBuffer.get(), length,
+                        offset)) {
+      return NS_ERROR_FAILURE;
+    }
+    offset += static_cast<off_t>(length);
+  }
+
+  char extraByte;
+  if (ReadAt(sourceDescriptor, &extraByte, 1, sourceStatus.st_size) != 0) {
+    return NS_ERROR_FAILURE;
+  }
+
+  offset = 0;
+  while (offset < sourceStatus.st_size) {
+    off_t remaining = sourceStatus.st_size - offset;
+    size_t length = remaining < static_cast<off_t>(kPromiseCopyBufferBytes)
+                        ? static_cast<size_t>(remaining)
+                        : kPromiseCopyBufferBytes;
+    if (!ReadExactlyAt(sourceDescriptor, sourceBuffer.get(), length, offset) ||
+        !ReadExactlyAt(deliveryDescriptor, deliveryBuffer.get(), length,
+                       offset) ||
+        memcmp(sourceBuffer.get(), deliveryBuffer.get(), length) != 0) {
+      return NS_ERROR_FAILURE;
+    }
+    offset += static_cast<off_t>(length);
+  }
+
+  struct stat finalSourceStatus;
+  struct stat finalDeliveryStatus;
+  if (fstat(sourceDescriptor, &finalSourceStatus) != 0 ||
+      fstat(deliveryDescriptor, &finalDeliveryStatus) != 0 ||
+      !SameRegularFileState(sourceStatus, finalSourceStatus) ||
+      !S_ISREG(finalDeliveryStatus.st_mode) ||
+      finalDeliveryStatus.st_uid != geteuid() ||
+      finalDeliveryStatus.st_nlink != 1 ||
+      finalDeliveryStatus.st_size != sourceStatus.st_size ||
+      (finalDeliveryStatus.st_mode & 0777) != 0600 ||
+      !FileDescriptorMatchesPath(sourceDescriptor, sourceFile,
+                                 finalSourceStatus) ||
+      !FileDescriptorMatchesPath(deliveryDescriptor, deliveryFile,
+                                 finalDeliveryStatus) ||
+      !DirectoryDescriptorMatchesPath(aSourceDirectoryDescriptor,
+                                      aSourceDirectory) ||
+      !DirectoryDescriptorMatchesPath(aDeliveryDirectoryDescriptor,
+                                      aDeliveryDirectory)) {
+    return NS_ERROR_FAILURE;
+  }
+
+  int closeResult = close(deliveryDescriptor);
+  closeDelivery.release();
+  if (closeResult != 0) {
+    return NS_ERROR_FAILURE;
+  }
+
+  struct stat closedDeliveryStatus;
+  nsAutoCString closedDeliveryPath;
+  if (NS_FAILED(deliveryFile->GetNativePath(closedDeliveryPath)) ||
+      lstat(closedDeliveryPath.get(), &closedDeliveryStatus) != 0 ||
+      !SameRegularFileState(finalDeliveryStatus, closedDeliveryStatus)) {
+    return NS_ERROR_FAILURE;
+  }
+
+  aAggregateBytes += sourceBytes;
+  aPromisedFiles.AppendElement(deliveryFile);
+  return NS_OK;
+}
+
+nsresult SnapshotPromisedFiles(
+    nsIFile* aSourceDirectory, int aSourceDirectoryDescriptor,
+    nsIFile* aDeliveryDirectory, int aDeliveryDirectoryDescriptor,
+    const nsTArray<nsString>& aPromisedNames,
+    PendingPromisedFiles& aPendingFiles,
+    AutoTArray<nsCOMPtr<nsIFile>, 4>& aPromisedFiles) {
+  uint64_t aggregateBytes = 0;
+  for (const auto& name : aPromisedNames) {
+    nsresult rv = SnapshotPromisedFile(
+        aSourceDirectory, aSourceDirectoryDescriptor, aDeliveryDirectory,
+        aDeliveryDirectoryDescriptor, name, aggregateBytes, aPendingFiles,
+        aPromisedFiles);
+    if (NS_FAILED(rv)) {
+      return rv;
+    }
+  }
+
+  return aPromisedFiles.Length() == aPromisedNames.Length() ? NS_OK
+                                                            : NS_ERROR_FAILURE;
+}
+
+nsresult MaterializeModernFilePromises(
+    NSPasteboard* aPasteboard, NSURL* aDestinationURL,
+    NSString* aStandardDestinationPath, uint32_t aExpectedPromiseCount,
+    AutoTArray<nsString, 4>& aPromisedNames) {
+  NSString* pasteboardName = [aPasteboard name];
+  if (!pasteboardName) {
+    return NS_ERROR_FAILURE;
+  }
+
+  PasteboardRef carbonPasteboard = nullptr;
+  OSStatus status =
+      PasteboardCreate((CFStringRef)pasteboardName, &carbonPasteboard);
+  if (!carbonPasteboard) {
+    return NS_ERROR_FAILURE;
+  }
+
+  auto releasePasteboard =
+      MakeScopeExit([carbonPasteboard]() { CFRelease(carbonPasteboard); });
+  if (status != noErr) {
+    return NS_ERROR_FAILURE;
+  }
+
+  PasteboardSynchronize(carbonPasteboard);
+  ItemCount itemCount = 0;
+  status = PasteboardGetItemCount(carbonPasteboard, &itemCount);
+  if (status != noErr || !itemCount || itemCount != aExpectedPromiseCount ||
+      itemCount > kMaximumPromisedFileCount) {
+    return NS_ERROR_FAILURE;
+  }
+
+  AutoTArray<PasteboardItemID, 4> promisedItemIdentifiers;
+  for (ItemCount index = 1; index <= itemCount; ++index) {
+    PasteboardItemID itemIdentifier = nullptr;
+    if (PasteboardGetItemIdentifier(carbonPasteboard, index, &itemIdentifier) !=
+        noErr) {
+      return NS_ERROR_FAILURE;
+    }
+
+    PasteboardFlavorFlags flags = 0;
+    if (PasteboardGetItemFlavorFlags(carbonPasteboard, itemIdentifier,
+                                     kPasteboardTypeFileURLPromise,
+                                     &flags) != noErr) {
+      continue;
+    }
+
+    // Apple's receiver protocol asks for the promised content type before it
+    // supplies the paste location and requests the promised file URL.
+    CFDataRef contentTypeData = nullptr;
+    status = PasteboardCopyItemFlavorData(carbonPasteboard, itemIdentifier,
+                                          kPasteboardTypeFilePromiseContent,
+                                          &contentTypeData);
+    if (status != noErr || !contentTypeData) {
+      if (contentTypeData) {
+        CFRelease(contentTypeData);
+      }
+      return NS_ERROR_FAILURE;
+    }
+    auto releaseContentTypeData =
+        MakeScopeExit([contentTypeData]() { CFRelease(contentTypeData); });
+    if (CFDataGetLength(contentTypeData) <= 0 ||
+        CFDataGetLength(contentTypeData) > kMaximumPromiseMetadataBytes) {
+      return NS_ERROR_FAILURE;
+    }
+    promisedItemIdentifiers.AppendElement(itemIdentifier);
+  }
+
+  // Do not silently discard ordinary pasteboard items from a mixed drag. The
+  // materialized result must represent the complete native item set.
+  if (promisedItemIdentifiers.IsEmpty() ||
+      promisedItemIdentifiers.Length() != itemCount) {
+    return NS_ERROR_FAILURE;
+  }
+
+  status =
+      PasteboardSetPasteLocation(carbonPasteboard, (CFURLRef)aDestinationURL);
+  if (status != noErr) {
+    return NS_ERROR_FAILURE;
+  }
+
+  for (PasteboardItemID itemIdentifier : promisedItemIdentifiers) {
+    CFDataRef URLData = nullptr;
+    status =
+        PasteboardCopyItemFlavorData(carbonPasteboard, itemIdentifier,
+                                     kPasteboardTypeFileURLPromise, &URLData);
+    if (status != noErr || !URLData) {
+      if (URLData) {
+        CFRelease(URLData);
+      }
+      return NS_ERROR_FAILURE;
+    }
+    auto releaseURLData = MakeScopeExit([URLData]() { CFRelease(URLData); });
+
+    CFIndex length = CFDataGetLength(URLData);
+    const UInt8* bytes = CFDataGetBytePtr(URLData);
+    if (!bytes) {
+      return NS_ERROR_FAILURE;
+    }
+    while (length > 0 && bytes[length - 1] == 0) {
+      --length;
+    }
+    if (length <= 0 || length > kMaximumPromiseMetadataBytes ||
+        memchr(bytes, 0, static_cast<size_t>(length))) {
+      return NS_ERROR_FAILURE;
+    }
+
+    NSString* URLString =
+        [[[NSString alloc] initWithBytes:bytes
+                                  length:static_cast<NSUInteger>(length)
+                                encoding:NSUTF8StringEncoding] autorelease];
+    NSURL* fileURL = URLString ? [NSURL URLWithString:URLString] : nil;
+    nsresult rv = ValidatePromiseURLAndAppendName(
+        fileURL, aStandardDestinationPath, aPromisedNames);
+    if (NS_FAILED(rv)) {
+      return rv;
+    }
+  }
+
+  if (aPromisedNames.Length() != promisedItemIdentifiers.Length()) {
+    return NS_ERROR_FAILURE;
+  }
+  return NS_OK;
+}
