+struct PromisedFileDirectory {
+  nsCOMPtr<nsIFile> mDirectory;
+  dev_t mDevice;
+  ino_t mInode;
+};
+
+struct PromisedFilePath {
+  nsCOMPtr<nsIFile> mFile;
+  dev_t mDevice;
+  ino_t mInode;
+};
+
+bool SameDirectoryIdentity(const struct stat& aLeft, const struct stat& aRight);
+bool DirectoryDescriptorMatchesPath(int aDescriptor, nsIFile* aDirectory);
+
+bool RemoveRegularFileIfUnchanged(const PromisedFilePath& aEntry) {
+  nsAutoCString nativePath;
+  struct stat fileStatus;
+  if (NS_FAILED(aEntry.mFile->GetNativePath(nativePath)) ||
+      lstat(nativePath.get(), &fileStatus) != 0 ||
+      !S_ISREG(fileStatus.st_mode) || fileStatus.st_nlink != 1 ||
+      fileStatus.st_uid != geteuid() || fileStatus.st_dev != aEntry.mDevice ||
+      fileStatus.st_ino != aEntry.mInode) {
+    return false;
+  }
+
+  return NS_SUCCEEDED(aEntry.mFile->Remove(false));
+}
