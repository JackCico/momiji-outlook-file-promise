+class PromisedFileCleanup final {
+ public:
+  bool AddDirectory(nsIFile* aDirectory) {
+    MOZ_ASSERT(aDirectory);
+
+    nsAutoCString nativePath;
+    struct stat directoryStatus;
+    if (NS_FAILED(aDirectory->GetNativePath(nativePath)) ||
+        lstat(nativePath.get(), &directoryStatus) != 0 ||
+        !S_ISDIR(directoryStatus.st_mode) ||
+        directoryStatus.st_uid != geteuid() ||
+        (directoryStatus.st_mode & 077) != 0) {
+      return false;
+    }
+
+    PromisedFileDirectory entry;
+    entry.mDirectory = aDirectory;
+    entry.mDevice = directoryStatus.st_dev;
+    entry.mInode = directoryStatus.st_ino;
+    mDirectories.AppendElement(std::move(entry));
+    return true;
+  }
+
+  bool AddFiles(const nsTArray<PromisedFilePath>& aExpectedFiles) {
+    uint64_t additionalBytes = 0;
+    for (const auto& expectedFile : aExpectedFiles) {
+      MOZ_ASSERT(expectedFile.mFile);
+
+      nsCOMPtr<nsIFile> parent;
+      if (NS_FAILED(expectedFile.mFile->GetParent(getter_AddRefs(parent))) ||
+          !parent) {
+        return false;
+      }
+
+      bool parentIsTracked = false;
+      for (const auto& directory : mDirectories) {
+        bool isSameDirectory = false;
+        if (NS_SUCCEEDED(
+                parent->Equals(directory.mDirectory, &isSameDirectory)) &&
+            isSameDirectory) {
+          parentIsTracked = true;
+          break;
+        }
+      }
+      if (!parentIsTracked) {
+        return false;
+      }
+
+      nsAutoCString nativePath;
+      struct stat fileStatus;
+      if (NS_FAILED(expectedFile.mFile->GetNativePath(nativePath)) ||
+          lstat(nativePath.get(), &fileStatus) != 0 ||
+          !S_ISREG(fileStatus.st_mode) || fileStatus.st_nlink != 1 ||
+          fileStatus.st_uid != geteuid() || fileStatus.st_size < 0 ||
+          (fileStatus.st_mode & 0777) != 0600 ||
+          fileStatus.st_dev != expectedFile.mDevice ||
+          fileStatus.st_ino != expectedFile.mInode) {
+        return false;
+      }
+
+      uint64_t fileBytes = static_cast<uint64_t>(fileStatus.st_size);
+      if (mRetainedBytes > kMaximumRetainedPromiseBytes ||
+          additionalBytes > kMaximumRetainedPromiseBytes - mRetainedBytes ||
+          fileBytes >
+              kMaximumRetainedPromiseBytes - mRetainedBytes - additionalBytes) {
+        return false;
+      }
+      additionalBytes += fileBytes;
+    }
+
+    mFiles.AppendElements(aExpectedFiles);
+    mRetainedBytes += additionalBytes;
+    return true;
+  }
+
+  bool TrackRelocationDestination(nsIFile* aOldDirectory,
+                                  nsIFile* aNewDirectory, int aDescriptor) {
+    MOZ_ASSERT(aOldDirectory);
+    MOZ_ASSERT(aNewDirectory);
+
+    nsAutoCString oldPath;
+    nsAutoCString newPath;
+    struct stat descriptorStatus;
+    struct stat oldPathStatus;
+    struct stat unexpectedDestination;
+    if (aDescriptor < 0 || NS_FAILED(aOldDirectory->GetNativePath(oldPath)) ||
+        NS_FAILED(aNewDirectory->GetNativePath(newPath)) ||
+        fstat(aDescriptor, &descriptorStatus) != 0 ||
+        lstat(oldPath.get(), &oldPathStatus) != 0 ||
+        !SameDirectoryIdentity(descriptorStatus, oldPathStatus) ||
+        lstat(newPath.get(), &unexpectedDestination) == 0 || errno != ENOENT) {
+      return false;
+    }
+
+    bool foundOldDirectory = false;
+    for (const auto& entry : mDirectories) {
+      nsAutoCString entryPath;
+      if (NS_SUCCEEDED(entry.mDirectory->GetNativePath(entryPath))) {
+        if (entryPath.Equals(newPath)) {
+          return false;
+        }
+        if (entry.mDevice == descriptorStatus.st_dev &&
+            entry.mInode == descriptorStatus.st_ino &&
+            entryPath.Equals(oldPath)) {
+          foundOldDirectory = true;
+        }
+      }
+    }
+    if (!foundOldDirectory) {
+      return false;
+    }
+
+    // Register the destination before rename(). At every point, shutdown
+    // cleanup therefore knows every path at which this exact directory may
+    // reside, even if a post-rename identity check fails.
+    PromisedFileDirectory destinationEntry;
+    destinationEntry.mDirectory = aNewDirectory;
+    destinationEntry.mDevice = descriptorStatus.st_dev;
+    destinationEntry.mInode = descriptorStatus.st_ino;
+    mDirectories.AppendElement(std::move(destinationEntry));
+    return true;
+  }
+
+  bool RemoveDirectoryNow(nsIFile* aDirectory) {
+    MOZ_ASSERT(aDirectory);
+
+    nsAutoCString nativePath;
+    if (NS_FAILED(aDirectory->GetNativePath(nativePath))) {
+      return false;
+    }
+
+    for (size_t index = 0; index < mDirectories.Length(); ++index) {
+      auto& entry = mDirectories[index];
+      nsAutoCString entryPath;
+      struct stat directoryStatus;
+      if (NS_FAILED(entry.mDirectory->GetNativePath(entryPath)) ||
+          !entryPath.Equals(nativePath) ||
+          lstat(nativePath.get(), &directoryStatus) != 0 ||
+          !S_ISDIR(directoryStatus.st_mode) ||
+          directoryStatus.st_uid != geteuid() ||
+          (directoryStatus.st_mode & 077) != 0 ||
+          directoryStatus.st_dev != entry.mDevice ||
+          directoryStatus.st_ino != entry.mInode) {
+        continue;
+      }
+
+      if (NS_FAILED(entry.mDirectory->Remove(false))) {
+        return false;
+      }
+      mDirectories.RemoveElementAt(index);
+      return true;
+    }
+    return false;
+  }
+
+  bool ForgetDirectoryPath(nsIFile* aDirectory) {
+    MOZ_ASSERT(aDirectory);
+
+    nsAutoCString nativePath;
+    if (NS_FAILED(aDirectory->GetNativePath(nativePath))) {
+      return false;
+    }
+    for (size_t index = 0; index < mDirectories.Length(); ++index) {
+      nsAutoCString entryPath;
+      if (NS_SUCCEEDED(
+              mDirectories[index].mDirectory->GetNativePath(entryPath)) &&
+          entryPath.Equals(nativePath)) {
+        mDirectories.RemoveElementAt(index);
+        return true;
+      }
+    }
+    return false;
+  }
+
+  ~PromisedFileCleanup() {
+    // Never recursively remove a path that was disclosed to another process.
+    // Delete only direct leaf files whose identities are unchanged, followed
+    // by now-empty tracked directories. Unknown or replaced entries are left
+    // for the operating system's temporary-directory policy.
+    for (const auto& entry : mFiles) {
+      Unused << RemoveRegularFileIfUnchanged(entry);
+    }
+
+    for (size_t index = mDirectories.Length(); index > 0; --index) {
+      const auto& entry = mDirectories[index - 1];
+      nsAutoCString nativePath;
+      struct stat directoryStatus;
+      if (NS_SUCCEEDED(entry.mDirectory->GetNativePath(nativePath)) &&
+          lstat(nativePath.get(), &directoryStatus) == 0 &&
+          S_ISDIR(directoryStatus.st_mode) &&
+          directoryStatus.st_uid == geteuid() &&
+          (directoryStatus.st_mode & 077) == 0 &&
+          directoryStatus.st_dev == entry.mDevice &&
+          directoryStatus.st_ino == entry.mInode) {
+        Unused << entry.mDirectory->Remove(false);
+      }
+    }
+  }
+
+ private:
+  nsTArray<PromisedFilePath> mFiles;
+  nsTArray<PromisedFileDirectory> mDirectories;
+  uint64_t mRetainedBytes = 0;
+};
+
+StaticAutoPtr<PromisedFileCleanup> sPromisedFileCleanup;
+
+void EnsurePromisedFileCleanup() {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!sPromisedFileCleanup) {
+    sPromisedFileCleanup = new PromisedFileCleanup();
+    ClearOnShutdown(&sPromisedFileCleanup, ShutdownPhase::AppShutdownConfirmed);
+  }
+}
+
+bool KeepPromisedFileDirectoryUntilShutdown(nsIFile* aDirectory) {
+  EnsurePromisedFileCleanup();
+  return sPromisedFileCleanup->AddDirectory(aDirectory);
+}
+
+bool KeepPromisedFilesUntilShutdown(const nsTArray<PromisedFilePath>& aFiles) {
+  EnsurePromisedFileCleanup();
+  return sPromisedFileCleanup->AddFiles(aFiles);
+}
+
+bool TrackPromisedFileDirectoryRelocationDestination(nsIFile* aOldDirectory,
+                                                     nsIFile* aNewDirectory,
+                                                     int aDescriptor) {
+  EnsurePromisedFileCleanup();
+  return sPromisedFileCleanup->TrackRelocationDestination(
+      aOldDirectory, aNewDirectory, aDescriptor);
+}
+
+bool RemoveTrackedPromisedFileDirectoryNow(nsIFile* aDirectory) {
+  EnsurePromisedFileCleanup();
+  return sPromisedFileCleanup->RemoveDirectoryNow(aDirectory);
+}
+
+bool ForgetTrackedPromisedFileDirectoryPath(nsIFile* aDirectory) {
+  EnsurePromisedFileCleanup();
+  return sPromisedFileCleanup->ForgetDirectoryPath(aDirectory);
+}
+
+class PendingPromisedFiles final {
+ public:
+  void AddSource(nsIFile* aFile, const struct stat& aStatus) {
+    Add(aFile, aStatus, mSources);
+  }
+
+  void AddDelivery(nsIFile* aFile, const struct stat& aStatus) {
+    Add(aFile, aStatus, mDeliveries);
+  }
+
+  bool RemoveSourcesNow() {
+    bool removedAll = true;
+    for (const auto& entry : mSources) {
+      if (!RemoveRegularFileIfUnchanged(entry)) {
+        removedAll = false;
+      }
+    }
+    return removedAll;
+  }
+
+  bool RetainDeliveriesUntilShutdown() {
+    if (!KeepPromisedFilesUntilShutdown(mDeliveries)) {
+      return false;
+    }
+    mCommitted = true;
+    return true;
+  }
+
+  ~PendingPromisedFiles() {
+    if (mCommitted) {
+      return;
+    }
+    for (const auto& entry : mDeliveries) {
+      Unused << RemoveRegularFileIfUnchanged(entry);
+    }
+    for (const auto& entry : mSources) {
+      Unused << RemoveRegularFileIfUnchanged(entry);
+    }
+  }
+
+ private:
+  static void Add(nsIFile* aFile, const struct stat& aStatus,
+                  nsTArray<PromisedFilePath>& aEntries) {
+    for (const auto& entry : aEntries) {
+      if (entry.mDevice == aStatus.st_dev && entry.mInode == aStatus.st_ino) {
+        return;
+      }
+    }
+
+    PromisedFilePath entry;
+    entry.mFile = aFile;
+    entry.mDevice = aStatus.st_dev;
+    entry.mInode = aStatus.st_ino;
+    aEntries.AppendElement(std::move(entry));
+  }
+
+  nsTArray<PromisedFilePath> mSources;
+  nsTArray<PromisedFilePath> mDeliveries;
+  bool mCommitted = false;
+};
+
+nsresult InventoryDirectPromiseFiles(nsIFile* aSourceDirectory,
+                                     int aSourceDirectoryDescriptor,
+                                     PendingPromisedFiles& aPendingFiles) {
+  if (!DirectoryDescriptorMatchesPath(aSourceDirectoryDescriptor,
+                                      aSourceDirectory)) {
+    return NS_ERROR_FAILURE;
+  }
+
+  nsCOMPtr<nsIDirectoryEnumerator> entries;
+  nsresult rv = aSourceDirectory->GetDirectoryEntries(getter_AddRefs(entries));
+  if (NS_FAILED(rv) || !entries) {
+    return NS_FAILED(rv) ? rv : NS_ERROR_FAILURE;
+  }
+  auto closeEntries =
+      MakeScopeExit([&entries]() { Unused << entries->Close(); });
+
+  uint32_t entryCount = 0;
+  while (true) {
+    nsCOMPtr<nsIFile> entry;
+    rv = entries->GetNextFile(getter_AddRefs(entry));
+    if (NS_FAILED(rv)) {
+      return rv;
+    }
+    if (!entry) {
+      break;
+    }
+    if (++entryCount > kMaximumPromiseDirectoryEntries) {
+      return NS_ERROR_FAILURE;
+    }
+
+    nsCOMPtr<nsIFile> parent;
+    bool parentMatches = false;
+    if (NS_FAILED(entry->GetParent(getter_AddRefs(parent))) || !parent ||
+        NS_FAILED(parent->Equals(aSourceDirectory, &parentMatches)) ||
+        !parentMatches) {
+      return NS_ERROR_FAILURE;
+    }
+
+    nsAutoCString nativePath;
+    struct stat entryStatus;
+    if (NS_FAILED(entry->GetNativePath(nativePath)) ||
+        lstat(nativePath.get(), &entryStatus) != 0) {
+      return NS_ERROR_FAILURE;
+    }
+    if (S_ISREG(entryStatus.st_mode) && entryStatus.st_uid == geteuid() &&
+        entryStatus.st_nlink == 1) {
+      aPendingFiles.AddSource(entry, entryStatus);
+    }
+  }
+
+  return DirectoryDescriptorMatchesPath(aSourceDirectoryDescriptor,
+                                        aSourceDirectory)
+             ? NS_OK
+             : NS_ERROR_FAILURE;
+}
+
+void CleanupFailedPromiseDirectory(nsIFile* aDirectory,
+                                   int aDirectoryDescriptor) {
+  if (!aDirectory) {
+    return;
+  }
+
+  Unused << fchmod(aDirectoryDescriptor, 0700);
+  PendingPromisedFiles pendingFiles;
+  if (NS_SUCCEEDED(InventoryDirectPromiseFiles(aDirectory, aDirectoryDescriptor,
+                                               pendingFiles)) &&
+      pendingFiles.RemoveSourcesNow()) {
+    if (!RemoveTrackedPromisedFileDirectoryNow(aDirectory) &&
+        DirectoryDescriptorMatchesPath(aDirectoryDescriptor, aDirectory)) {
+      // A tracking inconsistency must not strand an otherwise verified,
+      // empty directory. This remains an exact, non-recursive removal.
+      Unused << aDirectory->Remove(false);
+    }
+  }
+}
