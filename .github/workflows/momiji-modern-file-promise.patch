+constexpr uint64_t kMaximumPromisedFileAggregateBytes =
+    256ULL * 1024ULL * 1024ULL;
+constexpr uint64_t kMaximumRetainedPromiseBytes = 512ULL * 1024ULL * 1024ULL;
+constexpr size_t kPromiseCopyBufferBytes = 32 * 1024;
